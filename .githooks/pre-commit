#!/bin/sh
#
# 커밋 전에 lint · typecheck · test를 돌린다 (npm run verify).
#
# 이 파일은 저장소에 커밋돼 있고, package.json의 prepare 스크립트가
# core.hooksPath를 .githooks로 맞춘다. 그래서 npm install 한 번이면 훅이 붙는다.
# husky를 쓰지 않는 이유가 그것이다 — git이 이미 하는 일이라 의존성을 늘릴 까닭이 없다.
#
# 전체를 돌린다. 스테이지된 파일만 골라 검사하면 typecheck와 test가 의미를 잃는다.
# 한 파일만 고쳐도 깨지는 곳은 대개 그 파일이 아니다. 지금 4~5초면 끝난다.

set -e

# pre-commit은 작업 트리를 본다. 스테이지하지 않은 변경이 있으면 방금 통과한 것과
# 실제로 커밋되는 내용이 다르다. 조용히 넘어가면 통과한 커밋이 CI에서 깨진다.
if ! git diff --quiet; then
  echo "▸ 스테이지하지 않은 변경이 있습니다. 검사는 작업 트리 기준이라"
  echo "  커밋되는 내용과 다를 수 있습니다."
fi

echo "▸ npm run verify (lint · typecheck · test)"

if ! npm run verify --silent; then
  echo ""
  echo "✗ 검사가 실패해 커밋을 멈췄습니다."
  echo "  고친 뒤 다시 커밋하세요. 일부러 건너뛰려면: git commit --no-verify"
  exit 1
fi

echo "✓ 통과"
