# 카카오 개발자 콘솔 > 내 애플리케이션 > 앱 키 > JavaScript 키
# 플랫폼 > Web 에 http://localhost:3030 이 등록되어 있어야 지도가 뜬다.
NEXT_PUBLIC_KAKAO_MAP_KEY=

# Supabase — 대시보드 > Project Settings > API
# URL은 https://<project-ref>.supabase.co, 키는 anon(publishable) 키를 쓴다.
# service_role 키를 여기에 넣지 말 것 — NEXT_PUBLIC_은 브라우저로 그대로 나간다.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 배포 주소. canonical과 og:image 절대 URL의 기준점이다.
# 비워 두면 lib/site.ts가 현재 배포 주소로 떨어지므로 로컬에서는 없어도 된다.
NEXT_PUBLIC_SITE_URL=
